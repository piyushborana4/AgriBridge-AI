# AgriBridge AI — Environment Configuration (Phase 4.5)

# -------------------------------------------------------------
# 1. Google Gemini AI Engine
# -------------------------------------------------------------
# Your Google Gemini API Key (Required for AI Advisory, Crop Doctor, and Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Centralized Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# 2. Copernicus Data Space Ecosystem (CDSE) / Sentinel-2 STAC
# -------------------------------------------------------------
# Public STAC API endpoint for Sentinel-2 Level-2A surface reflectance passes
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# Optional CDSE OAuth2 credentials for high-throughput authenticated queries
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# -------------------------------------------------------------
# 3. Open-Meteo Weather Service
# -------------------------------------------------------------
# Open-Meteo API URL (Default: https://api.open-meteo.com/v1/forecast)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# -------------------------------------------------------------
# 4. ISRIC SoilGrids 2.0 Pedological Service
# -------------------------------------------------------------
# SoilGrids REST endpoint for 250m global soil property estimations
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# -------------------------------------------------------------
# 5. Backend Server Configuration
# -------------------------------------------------------------
PORT=3001
NODE_ENV=development
